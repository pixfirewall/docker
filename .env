# Variables used for docker-compose.yml interpolation.
# Service runtime configuration lives in env/*.env

SSL_CERTS_LOCATION="./certs"

POSTGRES_PORT=5432
MONGODB_PORT=27017
MYSQL_DATABASE_PORT=3306
MYSQL_ADMINER_PORT=8080

KONG_VERSION="3.7.1-ubuntu"

CONTAINER_REGISTRY=""
KEYCLOAK_VERSION="20240617.4"

# Keycloak build-time options (baked in by `kc.sh build`)
KC_HEALTH_ENABLED="true"
KC_METRICS_ENABLED="true"
KC_DB="postgres"

NATS_USER="lf-test"
NATS_PASSWORD="Gie4CheiboSei3quhaeW9aek"

# releases after 4.14 require LOCALSTACK_AUTH_TOKEN to be exported in your shell
LOCALSTACK_VERSION="4.14"

# Optional service groups started together with the default services, e.g.
# COMPOSE_PROFILES=tools,observability
# (image versions and host ports of the optional services can be overridden here too,
#  see the ${...:-default} values in docker-compose.yml)
