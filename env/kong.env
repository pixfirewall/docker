KONG_DATABASE=postgres
KONG_PG_HOST=postgres
KONG_PG_DATABASE=kong
KONG_PASSWORD=test
KONG_PG_USER=test
KONG_PG_PASSWORD=test
KONG_PROXY_ACCESS_LOG=/dev/stdout
KONG_PROXY_ERROR_LOG=/dev/stderr
KONG_PROXY_LISTEN='0.0.0.0:8000, 0.0.0.0:8443 ssl'
KONG_ADMIN_ACCESS_LOG=/dev/stdout
KONG_ADMIN_ERROR_LOG=/dev/stderr
KONG_ADMIN_LISTEN='0.0.0.0:8001, 0.0.0.0:8444 ssl'
KONG_ADMIN_GUI_URL=http://localhost:8002
KONG_SSL_CERT='/opt/certs/ca.pem'
KONG_SSL_CERT_KEY='/opt/certs/ca.key'
KONG_PLUGINS=bundled,oidc
# KONG_DECLARATIVE_CONFIG="/opt/kong/kong.yaml"
# Tracing, spans are only exported once the opentelemetry plugin is enabled (see README)
KONG_TRACING_INSTRUMENTATIONS=all
KONG_TRACING_SAMPLING_RATE=1.0
# nginx starts one worker per CPU by default (~50 MB each), two are plenty locally
KONG_NGINX_WORKER_PROCESSES=2
