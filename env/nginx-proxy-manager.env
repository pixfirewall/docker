# Nginx Proxy Manager admin login (defaults of a fresh installation, change them in the UI)
NPM_URL=http://nginx-proxy-manager:81
NPM_EMAIL=admin@example.com
NPM_PASSWORD=changeme
# host names created by the setup one-shot: <name>.localhost -> <service>:<port>
# (*.localhost resolves to 127.0.0.1 in browsers and curl)
NPM_PROXY_HOSTS=homepage:homepage:3000 kong:kong:8000 adminer:adminer:8080 grafana:grafana:3000 mailpit:mailpit:8025 jellyfin:jellyfin:8096 nextcloud:nextcloud:80 wiremock:wiremock:8080
