# https://github.com/useplunk/plunk/blob/main/.env.self-host.example
SERVICE=all
NODE_ENV=production
DATABASE_URL=postgresql://test:test@postgres:5432/plunk
DIRECT_DATABASE_URL=postgresql://test:test@postgres:5432/plunk
REDIS_URL=redis://redis:6379/3
JWT_SECRET=local-development-plunk-jwt-secret-change-me
NGINX_PORT=80
API_DOMAIN=api.localhost
DASHBOARD_DOMAIN=app.localhost
LANDING_DOMAIN=www.localhost
WIKI_DOMAIN=docs.localhost
USE_HTTPS=false
API_URI=http://api.localhost:8483
DASHBOARD_URI=http://app.localhost:8483
LANDING_URI=http://www.localhost:8483
WIKI_URI=http://docs.localhost:8483
# Plunk sends email through AWS SES only. By default SES is emulated by the localstack service
# (sent emails: http://localhost:4566/_aws/ses). For real delivery set your AWS credentials and
# remove AWS_ENDPOINT_URL.
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=test
AWS_SES_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
SES_CONFIGURATION_SET=plunk-configuration-set
S3_ENDPOINT=http://plunk-minio:9000
S3_ACCESS_KEY_ID=plunk
S3_ACCESS_KEY_SECRET=plunkminiopass
S3_BUCKET=uploads
S3_PUBLIC_URL=http://localhost:9000/uploads
S3_FORCE_PATH_STYLE=true
DISABLE_SIGNUPS=false
