# Generated from the Mailu 2024.06 compose flavor, adapted for local development.
# https://mailu.io/2024.06/configuration.html
SECRET_KEY=local-development-mailu-secret
SUBNET=192.168.203.0/24
DOMAIN=example.test
HOSTNAMES=mail.example.test
POSTMASTER=admin
# TLS with the development certificate from ./certs (mounted as /certs/cert.pem + key.pem)
TLS_FLAVOR=cert
AUTH_RATELIMIT_IP=10000/hour
AUTH_RATELIMIT_USER=10000/day
DISABLE_STATISTICS=True
ADMIN=true
WEBMAIL=roundcube
API=false
WEBDAV=none
ANTIVIRUS=none
SCAN_MACROS=false
MESSAGE_SIZE_LIMIT=50000000
RELAYNETS=
# outgoing mail to other domains is delivered to mailpit instead of the internet
RELAYHOST=mailpit:1025
FETCHMAIL_ENABLED=False
RECIPIENT_DELIMITER=+
DMARC_RUA=admin
DMARC_RUF=admin
WELCOME=false
COMPRESSION=
COMPRESSION_LEVEL=
FULL_TEXT_SEARCH=off
WEBROOT_REDIRECT=/webmail
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEB_API=/api
SITENAME=Mailu (dev)
WEBSITE=https://localhost:8481
COMPOSE_PROJECT_NAME=docker
CREDENTIAL_ROUNDS=12
REAL_IP_HEADER=
REAL_IP_FROM=
REJECT_UNLISTED_RECIPIENT=
LOG_LEVEL=INFO
TZ=Etc/UTC
DEFAULT_SPAM_THRESHOLD=80
# admin account created on first start: admin@example.test
INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_DOMAIN=example.test
INITIAL_ADMIN_PW=admin-password-123
INITIAL_ADMIN_MODE=ifmissing
