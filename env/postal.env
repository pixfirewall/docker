# https://docs.postalserver.io/getting-started/configuration (environment variables)
POSTAL_WEB_HOSTNAME=localhost:8482
POSTAL_WEB_PROTOCOL=http
POSTAL_SMTP_HOSTNAME=postal.example.test
POSTAL_SIGNING_KEY_PATH=/config/signing.key
# deliver all outgoing mail to mailpit instead of the internet
POSTAL_SMTP_RELAYS=smtp://mailpit:1025
WEB_SERVER_DEFAULT_BIND_ADDRESS=0.0.0.0
MAIN_DB_HOST=postal-mariadb
MAIN_DB_USERNAME=root
MAIN_DB_PASSWORD=postal
MAIN_DB_DATABASE=postal
MESSAGE_DB_HOST=postal-mariadb
MESSAGE_DB_USERNAME=root
MESSAGE_DB_PASSWORD=postal
MESSAGE_DB_DATABASE_NAME_PREFIX=postal
DNS_MX_RECORDS=mx.postal.example.test
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_ADDRESS=postal@example.test
RAILS_SECRET_KEY=local-development-postal-secret-key-change-me-0123456789abcdef
MIGRATION_WAITER_ENABLED=true
