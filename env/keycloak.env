KC_HEALTH_ENABLED="true"
KC_METRICS_ENABLED="true"
KC_DB="postgres"
KC_DB_URL="jdbc:postgresql://postgres/keycloak"
# KC_DB_URL="jdbc:postgresql://postgres/keycloak?&sslmode=verify-ca&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory"
KC_DB_USERNAME="test"
KC_DB_PASSWORD="test"
KC_BOOTSTRAP_ADMIN_USERNAME="admin"
KC_BOOTSTRAP_ADMIN_PASSWORD="admin"
# Full public URL, so tokens always carry the same issuer, no matter which host name is used to reach Keycloak
KC_HOSTNAME="https://localhost:8445"
# Containers (e.g. Kong) can still call https://keycloak:8443 directly for backchannel requests such as token
# introspection. Do not enable KC_HOSTNAME_BACKCHANNEL_DYNAMIC: the issuer check would then use the container
# host name and introspection of tokens issued to the browser / host reports them as inactive.
# KC_HOSTNAME_ADMIN="https://localhost"
# KC_HOSTNAME_STRICT="true"
# KC_HOSTNAME_STRICT_HTTPS="false"
# KC_HOSTNAME_STRICT_BACKCHANNEL="true"
KC_HTTPS_CERTIFICATE_FILE="/opt/certs/conf/keys/ca.pem"
KC_HTTPS_CERTIFICATE_KEY_FILE="/opt/certs/conf/keys/ca.key"
# Keycloak sizes its heap from the memory of the Docker VM (70%), cap it for local development
JAVA_OPTS_KC_HEAP="-Xms256m -Xmx768m"
# health (/health/ready) and metrics on port 9000 over plain HTTP, the port is not published on the host
KC_HTTP_MANAGEMENT_SCHEME="http"
