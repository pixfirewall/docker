# https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/
OVERRIDE_HOSTNAME=mail.example.test
# TLS with the development certificate from ./certs
SSL_TYPE=manual
SSL_CERT_PATH=/certs/ca.pem
SSL_KEY_PATH=/certs/ca.key
# lightweight for local development
ENABLE_CLAMAV=0
ENABLE_SPAMASSASSIN=0
ENABLE_RSPAMD=0
ENABLE_AMAVIS=0
ENABLE_FAIL2BAN=0
ENABLE_POSTGREY=0
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
# trust the docker network (other containers may send without authentication)
PERMIT_DOCKER=connected-networks
# outgoing mail to other domains is delivered to mailpit instead of the internet
DEFAULT_RELAY_HOST=[mailpit]:1025
ONE_DIR=1
LOG_LEVEL=info
